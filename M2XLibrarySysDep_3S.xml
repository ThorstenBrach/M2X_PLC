      <pou name="SysDepIsValidLReal" pouType="function">
        <interface>
          <returnType>
            <BOOL />
          </returnType>
          <inputVars>
            <variable name="Value">
              <type>
                <LREAL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Value to check</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <localVars>
            <variable name="_pBits">
              <type>
                <pointer>
                  <baseType>
                    <LWORD />
                  </baseType>
                </pointer>
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Pointer to the bit pattern of the value</xhtml>
              </documentation>
            </variable>
            <variable name="_exponent">
              <type>
                <LWORD />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Exponent of the IEEE 754 double</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> System dependent check whether an LREAL is a finite number</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">  // IEEE 754: exponent 16#7FF = infinity or NaN
 _pBits    := ADR(Value);
 _exponent := SHR(_pBits^, 52) AND 16#7FF;

  SysDepIsValidLReal := ( _exponent &lt;&gt; 16#7FF );
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/objectid" handleUnknown="discard">
            <ObjectId>686cdd58-698d-4a68-915e-18bd37cfa979</ObjectId>
          </data>
        </addData>
      </pou>
      <pou name="SysDepGetSeed" pouType="function">
        <interface>
          <returnType>
            <UDINT />
          </returnType>
          <localVars>
            <variable name="_now">
              <type>
                <ULINT />
              </type>
              <documentation>
