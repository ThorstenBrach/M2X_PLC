      <pou name="SysDepGetUtcTime" pouType="function">
        <interface>
          <returnType>
            <BOOL />
          </returnType>
          <inOutVars>
            <variable name="DateTime">
              <type>
                <derived name="SysDepDateTime" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Current UTC date and time</xhtml>
              </documentation>
            </variable>
          </inOutVars>
          <localVars>
            <variable name="_now">
              <type>
                <ULINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Real time clock in ms since 1970-01-01 (UTC)</xhtml>
              </documentation>
            </variable>
            <variable name="_result">
              <type>
                <derived name="RTS_IEC_RESULT" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Result of the system call</xhtml>
              </documentation>
            </variable>
            <variable name="_msOfDay">
              <type>
                <ULINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Milliseconds of the current day</xhtml>
              </documentation>
            </variable>
            <variable name="_z">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Days since 1970-01-01, shifted to 0000-03-01</xhtml>
              </documentation>
            </variable>
            <variable name="_era">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Era of 400 years</xhtml>
              </documentation>
            </variable>
            <variable name="_doe">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Day of the era 0..146096</xhtml>
              </documentation>
            </variable>
            <variable name="_yoe">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Year of the era 0..399</xhtml>
              </documentation>
            </variable>
            <variable name="_doy">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Day of the year, starting at March 1st</xhtml>
              </documentation>
            </variable>
            <variable name="_mp">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Month, starting at March = 0</xhtml>
              </documentation>
            </variable>
            <variable name="_month">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Month 1..12</xhtml>
              </documentation>
            </variable>
            <variable name="_year">
              <type>
                <DINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Year</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> System dependent reading of the current UTC date and time</xhtml>
          </documentation>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> _result := SysTimeRtc.SysTimeRtcHighResGet(pTimestamp := ADR(_now));
  IF ( _result &lt;&gt; 0 )
  THEN
    RETURN;
  END_IF

 _msOfDay := _now MOD 86400000;

  // Civil date from days since 1970-01-01 (H. Hinnant, days_from_civil inverse)
 _z     := ULINT_TO_DINT(_now / 86400000) + 719468;
 _era   := _z / 146097;
 _doe   := _z - _era * 146097;
 _yoe   := ( _doe - _doe / 1460 + _doe / 36524 - _doe / 146096 ) / 365;
 _doy   := _doe - ( 365 * _yoe + _yoe / 4 - _yoe / 100 );
 _mp    := ( 5 * _doy + 2 ) / 153;
 _year  := _yoe + _era * 400;

  IF ( _mp &lt; 10 )
  THEN
   _month := _mp + 3;
  ELSE
   _month := _mp - 9;
  END_IF

  IF ( _month &lt;= 2 )
  THEN
   _year := _year + 1;
  END_IF

  DateTime.Year        := DINT_TO_UINT(_year);
  DateTime.Month       := DINT_TO_UINT(_month);
  DateTime.Day         := DINT_TO_UINT(_doy - ( 153 * _mp + 2 ) / 5 + 1);
  DateTime.Hour        := ULINT_TO_UINT(_msOfDay / 3600000);
  DateTime.Minute      := ULINT_TO_UINT(( _msOfDay / 60000 ) MOD 60);
  DateTime.Second      := ULINT_TO_UINT(( _msOfDay / 1000 ) MOD 60);
  DateTime.Millisecond := ULINT_TO_UINT(_msOfDay MOD 1000);

  SysDepGetUtcTime := TRUE;
</xhtml>
          </ST>
        </body>
