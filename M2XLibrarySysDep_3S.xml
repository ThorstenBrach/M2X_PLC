            <xhtml xmlns="http://www.w3.org/1999/xhtml"> _result := SysTimeRtc.SysTimeRtcHighResGet(pTimestamp := ADR(_now));

  SysDepGetSeed := ULINT_TO_UDINT(_now) XOR ULINT_TO_UDINT(SHR(_now, 32));
</xhtml>
