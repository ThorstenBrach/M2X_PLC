              </documentation>
            </variable>
            <variable name="ErrorId">
              <type>
                <UDINT />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Error code of the platform</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars constant="true">
            <variable name="ERROR_NOT_IMPLEMENTED">
              <type>
                <UDINT />
              </type>
              <initialValue>
                <simpleValue value="16#FFFF" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Error code: no MQTT library bound yet</xhtml>
              </documentation>
            </variable>
          </localVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> System dependent MQTT client (CODESYS: binding to the MQTT library still open)</xhtml>
          </documentation>
        </interface>
